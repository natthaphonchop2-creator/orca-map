# Server-side connection to the existing ORCA/Obot runtime. No token required.
ORCA_BACKEND_URL=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=4000
ORCA_BUILD_DIR=build

# Set this exact browser origin for remote deployment behind a TLS reverse proxy.
# ORCA_PUBLIC_ORIGIN=https://app.example.com

# Optional: backend's advertised origin when it differs from its internal URL.
# Used only to translate outer Location response headers, never OAuth query data.
ORCA_BACKEND_PUBLIC_ORIGIN=http://localhost:8787
